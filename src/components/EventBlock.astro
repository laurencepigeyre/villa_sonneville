---
import { Image } from 'astro:assets';
import { marked } from 'marked';

const {
  reverse = false,
  image,
  caption = '',
  date = '',
  title = '',
  subtitle = '',
  category = '',
  description = '',
  link = '#',
  linkLabel = 'Découvrir',
  target_blank = false,
  statut,
} = Astro.props;

const flexDirection = reverse ? 'md:flex-row-reverse' : 'md:flex-row';
const target = target_blank ? '_blank' : '_self';
const rel = target_blank ? 'noopener noreferrer' : undefined;

const descriptionHtml = description ? marked.parse(description, { breaks: true, gfm: true }) : '';
---

<div class={`flex flex-col ${flexDirection} items-center m-10`}>
  <!-- Image -->
  <div class="w-full md:w-1/2 px-3 flex justify-center flex-col">
    {
      image && (
        <Image
          src={image}
          alt={title}
          width={image.width}
          height={image.height}
          format="webp"
          quality={60}
          widths={[320, 480, 640, 768, 1024]}
          sizes="(max-width: 768px) 100vw, 40vw"
          layout="constrained"
          class="w-full h-auto rounded-lg"
        />
      )
    }

    {caption && <figcaption class="text-gray-500 text-sm py-3">{caption}</figcaption>}
  </div>

  <!-- Texte -->
  <div class="w-full md:w-1/2 p-4 sm:p-6 md:p-8">
    {statut && <p>{statut}</p>}
    {date && <p>{date}</p>}

    {title && <h1 class="text-4xl font-bold">{title}</h1>}

    {subtitle && <h2 class="text-2xl">{subtitle}</h2>}

    {category && <p class="uppercase tracking-wide text-sm">{category}</p>}

    {description && <div class="mt-4 [&_p]:mb-4" set:html={descriptionHtml} />}
    <a
      href={link}
      target={target}
      rel={rel}
      class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-200 rounded-lg mt-5 hover:bg-zinc-300">
      {linkLabel}
      <span class="text-lg">→</span>
    </a>
  </div>
</div>
