---
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Villa Sonneville, maison-galerie d’art à Roubaix : expositions, résidences et événements culturels dans une demeure historique d'exception des années 1920.",
} = Astro.props;
import stylesUrl from '../styles/global.css?url';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { Font } from 'astro:assets';
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- <ClientRouter /> -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta property="locale" content="fr_FR" />
    <meta property="title" content="Galerie d'art - Villa Sonnneville" />
    <meta name="description" content={description} />
    <meta
      property="og:description"
      content="Expositions d'art contemporain, résidences d'artistes et événements culturels dans une demeure historique des années 1920, à Roubaix."
    />
    <meta property="og:image" content="https://www.villasonneville.art/HD-H_DSC9840-Villa-Sonneville-Vue-.jpeg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.villasonneville.art/" />
    <!-- Favicon classique -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <!-- PNG haute résolution -->
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <!-- Apple Touch Icon (iPhone/iPad) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>Villa Sonneville - {title}</title>
    <link rel="preload" href={stylesUrl} as="style" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="Villa Sonneville | Maison-Galerie d'Art à Roubaix" />

    <link rel="stylesheet" href={stylesUrl} />
    <Font cssVariable="--font-montserrat" preload />
  </head>
  <!-- transition:animate={fade({ duration: '0.2s' })} -->
  <body class="font-montserrat pt-16">
    <NavBar />

    <main>
      <slot />
    </main>

    <Footer />
    <script>
      import '../scripts/burger-menu.js';
    </script>
  </body>
</html>
